page {
  background-color: #f5f5f5;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', sans-serif;
  color: #1f1f1f;
}

.card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-top: 24rpx;
  text-align: center;
}

.btn-primary {
  background-color: #ff6b6b;
  color: #fff;
}

.btn-secondary {
  background-color: #fff5f5;
  color: #ff6b6b;
  border: 2rpx solid #ffaba6;
}
