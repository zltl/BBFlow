page {
  background: #f6f8fb;
}

.page {
  padding: 24rpx;
}

.hero-card,
.stat-card,
.empty-card,
.token-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: center;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.primary-btn {
  background: #1677ff;
  color: #fff;
}

.stats-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-card {
  padding: 28rpx;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.stat-label {
  margin-top: 10rpx;
  display: block;
  font-size: 24rpx;
  color: #64748b;
}

.empty-card {
  margin-top: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.token-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.token-card {
  padding: 28rpx;
}

.token-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.token-code {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  word-break: break-all;
}

.token-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.status {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status.active {
  background: rgba(82, 196, 26, 0.12);
  color: #389e0d;
}

.status.warning {
  background: rgba(250, 173, 20, 0.14);
  color: #d48806;
}

.status.muted {
  background: rgba(148, 163, 184, 0.14);
  color: #64748b;
}

.detail-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.detail-item {
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.detail-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
}

.actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.ghost-btn,
.danger-btn {
  flex: 1;
  margin: 0;
}

.ghost-btn {
  background: #eef4ff;
  color: #1668dc;
}

.danger-btn {
  background: #fff1f0;
  color: #cf1322;
}
