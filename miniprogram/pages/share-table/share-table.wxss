.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f6f6f6;
  min-height: 100vh;
}

.header {
  width: 100%;
  margin-bottom: 30rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
}

.preview-scroll {
  width: 100%;
  overflow: auto;
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.preview-area {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  background: #fff;
}

.action-area {
  width: 100%;
  padding-bottom: 40rpx;
}

.btn-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn .btn-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-btn.save {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
}

.action-btn.share {
  background: linear-gradient(135deg, #52c41a, #389e0d);
  color: #fff;
}

.action-btn.print {
  background: linear-gradient(135deg, #fa8c16, #d46b08);
  color: #fff;
}

.save-btn {
  width: 80%;
  margin-bottom: 20rpx;
}

.tips {
  text-align: center;
  font-size: 24rpx;
  color: #999;
}
