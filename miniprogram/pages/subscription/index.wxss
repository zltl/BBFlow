page {
  background: #f6f8fb;
}

.page {
  padding: 24rpx;
}

.notice-card,
.status-card,
.card,
.plan-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
}

.notice-card,
.status-card,
.card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.notice-title,
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.notice-desc,
.status-meta,
.plan-desc,
.history-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.status-label {
  font-size: 24rpx;
  color: #64748b;
}

.status-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.status-value.active {
  color: #389e0d;
}

.status-value.inactive {
  color: #fa8c16;
}

.plan-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-card {
  padding: 28rpx;
}

.plan-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-name,
.history-plan {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.plan-price {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1677ff;
}

.plan-days {
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1668dc;
  font-size: 22rpx;
}

.primary-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #fff;
}

.history-item + .history-item {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f7;
}
