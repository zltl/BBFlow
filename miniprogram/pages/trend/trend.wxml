<view class="container">
  <view class="chart-container">
    <view class="chart-header">
      <view class="header-left">
        <text class="chart-label">血压趋势</text>
        <view class="legend-mini">
          <view class="legend-item-mini">
            <view class="color-box-mini normal"></view>
            <text>正常</text>
          </view>
          <view class="legend-item-mini">
            <view class="color-box-mini level1"></view>
            <text>一级</text>
          </view>
          <view class="legend-item-mini">
            <view class="color-box-mini level2"></view>
            <text>危险</text>
          </view>
        </view>
      </view>
      <view class="header-right">
        <view class="auto-avg-switch" bindtap="toggleAutoAverage">
          <text class="switch-label">自动均值</text>
          <view class="switch-icon {{autoAverage ? 'active' : ''}}">
            <view class="switch-circle"></view>
          </view>
        </view>
        <view class="legend-inline">
          <view class="legend-item">
            <view class="dot high"></view>
            <text>收缩压</text>
          </view>
          <view class="legend-item">
            <view class="dot low"></view>
            <text>舒张压</text>
          </view>
        </view>
      </view>
    </view>
    <view class="chart-body">
      <canvas type="2d" id="yAxisBP" class="y-axis" style="width: 40px; height: 500rpx;"></canvas>
      <scroll-view scroll-x="true" class="chart-scroll" scroll-left="{{scrollLeft}}" bindscroll="handleBPScroll" bindscrolltoupper="onScrollToLeft" upper-threshold="100">
        <canvas type="2d" id="trendChart" class="chart" style="width: {{canvasWidth}}px; height: 500rpx;" bindlongpress="onChartLongPress" bindtouchend="onChartTouchEnd"></canvas>
      </scroll-view>
      
      <!-- Tooltip -->
      <view class="tooltip" wx:if="{{tooltip.visible}}" style="left: {{tooltip.x}}px; top: {{tooltip.y}}px;">
        <view class="tooltip-date">{{tooltip.date}} {{tooltip.time}}</view>
        <view class="tooltip-row">
          <view class="dot high"></view>
          <text>收缩压: {{tooltip.systolic}}</text>
        </view>
        <view class="tooltip-row">
          <view class="dot low"></view>
          <text>舒张压: {{tooltip.diastolic}}</text>
        </view>
        <view class="tooltip-row">
          <view class="dot heart-rate"></view>
          <text>心率: {{tooltip.heartRate}}</text>
        </view>
      </view>
    </view>
    <!-- Footer removed as legend moved to header -->
  </view>

  <view class="chart-container chart-compact">
    <view class="chart-header">
      <text class="chart-label">心率趋势</text>
      <view class="legend-inline">
        <view class="legend-item">
          <view class="dot heart-rate"></view>
          <text>心率</text>
        </view>
      </view>
    </view>
    <view class="chart-body">
      <canvas type="2d" id="yAxisHR" class="y-axis" style="width: 40px; height: 400rpx;"></canvas>
      <scroll-view scroll-x="true" class="chart-scroll" scroll-left="{{scrollLeftHR}}" bindscroll="handleHRScroll">
        <canvas type="2d" id="heartRateChart" class="chart" style="width: {{canvasWidthHR}}px; height: 400rpx;"></canvas>
      </scroll-view>
    </view>
  </view>
</view>
