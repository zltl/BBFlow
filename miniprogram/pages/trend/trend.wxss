/* Global Page Settings - Grafana Light Theme */
page {
  background-color: #f4f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

.container {
  width: 100vw;
  box-sizing: border-box;
  padding: 20rpx 0;
  padding-bottom: 60rpx;
}

/* Chart Section - Grafana Light Theme */
.chart-container {
  width: 100%;
  background-color: #ffffff;
  border-radius: 0;
  padding: 0;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(24, 26, 27, 0.08);
  border-top: 1rpx solid rgba(36, 41, 46, 0.08);
  border-bottom: 1rpx solid rgba(36, 41, 46, 0.08);
  overflow: hidden;
}

.chart-compact {
  margin-top: 20rpx;
}

.chart-header {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid rgba(36, 41, 46, 0.12);
  background-color: #fafafa;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 20rpx;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.chart-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #18181b;
  letter-spacing: 0.5rpx;
}

.legend-inline {
  display: flex;
  gap: 24rpx;
}

.auto-avg-switch {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.switch-label {
  font-size: 24rpx;
  color: #666;
}

.switch-icon {
  width: 80rpx;
  height: 40rpx;
  background-color: #e0e0e0;
  border-radius: 40rpx;
  position: relative;
  transition: background-color 0.3s;
}

.switch-icon.active {
  background-color: #1890ff;
}

.switch-circle {
  width: 32rpx;
  height: 32rpx;
  background-color: #fff;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
}

.switch-icon.active .switch-circle {
  left: 44rpx;
}

.chart-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #18181b;
  margin-bottom: 20rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.chart-scroll {
  width: 100%;
  height: 520rpx;
  background-color: #ffffff;
  padding: 20rpx 0;
  white-space: nowrap;
  overflow-x: scroll;
}

.chart {
  height: 500rpx;
  display: inline-block;
  /* pointer-events: none; Removed to allow longpress interaction */
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid rgba(36, 41, 46, 0.12);
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #18181b;
  font-weight: 500;
  padding: 0;
  background-color: transparent;
  border-radius: 0;
  border: none;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.dot.high {
  background-color: #FF6B6B;
  color: #FF6B6B;
}

.dot.low {
  background-color: #4D96FF;
  color: #4D96FF;
}

.dot.heart-rate {
  background-color: #FFC107;
  color: #FFC107;
}

/* Chart Footer */
.chart-footer {
  padding: 16rpx 30rpx;
  border-top: 1rpx solid rgba(36, 41, 46, 0.06);
  background-color: #fafafa;
  display: flex;
  align-items: center;
}

.legend-label {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-right: 16rpx;
}

.legend-grid {
  display: flex;
  gap: 20rpx;
}

.legend-item-small {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #52545c;
}

.color-box {
  width: 24rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 2rpx;
}

.color-box.normal {
  background-color: rgba(82, 196, 26, 0.4);
}

.color-box.level1 {
  background-color: rgba(250, 173, 20, 0.4);
}

.color-box.level2 {
  background-color: rgba(255, 77, 79, 0.4);
}

/* Mini Legend in Header */
.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.legend-mini {
  display: flex;
  gap: 12rpx;
}

.legend-item-mini {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #999;
}

.color-box-mini {
  width: 16rpx;
  height: 16rpx;
  margin-right: 6rpx;
  border-radius: 4rpx;
}

.color-box-mini.normal {
  background-color: rgba(82, 196, 26, 0.4);
}

.color-box-mini.level1 {
  background-color: rgba(250, 173, 20, 0.4);
}

.color-box-mini.level2 {
  background-color: rgba(255, 77, 79, 0.4);
}

/* Tooltip */
.tooltip {
  position: absolute;
  background-color: rgba(0, 0, 0, 0.8);
  border-radius: 8rpx;
  padding: 16rpx;
  z-index: 100;
  pointer-events: none;
  transform: translate(-50%, -120%);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.tooltip::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  border-width: 10rpx 10rpx 0;
  border-style: solid;
  border-color: rgba(0, 0, 0, 0.8) transparent transparent;
}

.tooltip-date {
  font-size: 22rpx;
  color: #ccc;
  margin-bottom: 8rpx;
  text-align: center;
}

.tooltip-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.tooltip-row text {
  font-size: 24rpx;
  color: #fff;
  font-family: 'DIN Alternate', sans-serif;
}

.tooltip-row .dot {
  width: 12rpx;
  height: 12rpx;
  border: none;
  margin-right: 8rpx;
}

/* Stats Section */
.stats-container {
  display: flex;
  justify-content: space-between;
  background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);
  border: 1rpx solid #e8f5e9;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background-color: #eee;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  font-family: 'DIN Alternate', 'Roboto', sans-serif; /* Use a number-friendly font if available */
}

.stat-value.highlight {
  color: #07c160;
}

.chart-body {
  position: relative;
  width: 100%;
}

.y-axis {
  position: absolute;
  left: 0;
  top: 0;
  width: 40px;
  background-color: transparent;
  border-right: 1rpx solid rgba(36, 41, 46, 0.05);
  z-index: 10;
  pointer-events: none;
}
