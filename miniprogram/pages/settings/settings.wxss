.container { padding: 16px; }
.section { margin-bottom: 20px; }
.title { font-weight: bold; margin-bottom: 8px; }
.note { color: #666; font-size: 12px; line-height: 1.8; }
input, textarea, picker, button { display: block; width: 100%; margin-bottom: 8px; }
textarea { height: 120px; }
.id-row { display: flex; align-items: center; background: #f5f5f5; padding: 10px; border-radius: 4px; }
.id-text { flex: 1; font-family: monospace; font-size: 12px; word-break: break-all; }
.copy-btn { flex-shrink: 0; margin-left: 10px; }
.share-btn { flex-shrink: 0; margin-left: 5px; background: #07c160; color: white; }
.picker-view { padding: 10px; background: #f5f5f5; border-radius: 4px; }

/* Status section */
.status-section { background: #f0f5ff; padding: 15px; border-radius: 8px; border: 1px solid #adc6ff; }
.status-row { display: flex; align-items: center; margin-bottom: 6px; }
.quota-tip { margin: 8px 0 12px; font-size: 12px; color: #1677ff; line-height: 1.5; }
.status-label { color: #666; font-size: 14px; width: 80px; }
.status-value { font-size: 14px; font-weight: 500; }
.status-paid { color: #52c41a; }
.status-sponsored { color: #1890ff; }
.status-free { color: #999; }

/* Invite section */
.invite-section { background: #f6ffed; padding: 15px; border-radius: 8px; border: 1px solid #b7eb8f; }
.invite-info { color: #666; font-size: 13px; margin-bottom: 10px; }
.create-invite-btn { margin-bottom: 15px; }
.invite-list { margin-top: 10px; }
.invite-item { background: #fff; padding: 12px; margin-bottom: 8px; border-radius: 6px; border: 1px solid #e8e8e8; }
.invite-item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.invite-code { font-family: monospace; font-size: 14px; font-weight: bold; }
.invite-status { font-size: 12px; }
.invite-status.used { color: #52c41a; }
.invite-status.unused { color: #faad14; }
.invite-item-detail { margin-bottom: 6px; }
.invite-detail-text { font-size: 12px; color: #999; }
.invite-item-actions { display: flex; gap: 8px; }
.invite-item-actions button { flex: none; width: auto; margin-bottom: 0; }
.invite-tip { color: #666; font-size: 12px; margin-top: 10px; line-height: 1.6; }

/* Admin section */
.admin-section { background: #fff7e6; padding: 15px; border-radius: 8px; border: 1px solid #ffd591; }
.form-row { display: flex; align-items: center; margin-bottom: 10px; }
.form-row text { width: 80px; font-size: 14px; }
.form-row input { flex: 1; background: #fff; border: 1px solid #ddd; border-radius: 4px; padding: 8px; }
.generated-codes { margin-top: 15px; background: #f6ffed; border: 1px solid #b7eb8f; padding: 10px; border-radius: 4px; }
.code-item { font-family: monospace; background: #fff; padding: 8px; margin: 5px 0; border-radius: 4px; border: 1px solid #d9d9d9; }

.section-btn {
  margin-top: 12px;
  border-radius: 999px;
  background: #eef4ff;
  color: #1668dc;
}

.section-btn.primary {
  background: #1677ff;
  color: #fff;
}

.quick-section,
.support-section {
  background: #ffffff;
  padding: 15px;
  border-radius: 8px;
  border: 1px solid #e8eef6;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-top: 10px;
}

.quick-item {
  background: #f8fafc;
  border: 1px solid #e8eef6;
  border-radius: 10px;
  padding: 14px 10px;
  text-align: center;
}

.quick-icon {
  display: block;
  font-size: 20px;
}

.quick-text {
  display: block;
  margin-top: 6px;
  font-size: 13px;
  color: #334155;
}

.analytics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 12px;
}

.analytics-item {
  background: #fff;
  border-radius: 8px;
  border: 1px solid #ffe7ba;
  padding: 10px;
}

.analytics-value {
  display: block;
  font-size: 18px;
  font-weight: 700;
  color: #ad6800;
}

.analytics-label {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #8c8c8c;
}

.admin-search {
  margin-bottom: 12px;
}

.search-result {
  margin-bottom: 12px;
}

.search-result-item {
  background: #fff;
  border-radius: 8px;
  border: 1px solid #ffe7ba;
  padding: 10px;
  margin-bottom: 8px;
}

.result-title {
  display: block;
  font-weight: 600;
  color: #333;
}

.result-meta {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #8c8c8c;
  word-break: break-all;
}
