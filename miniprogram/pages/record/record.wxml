<view class="page">
  <view class="card">
    <view class="section-title">血压数据</view>
    
    <view class="form-item">
      <view class="label">收缩压（高压）<text class="unit">mmHg</text></view>
      <input class="input" type="digit" placeholder="请输入收缩压（70-260）" value="{{systolic}}" bindinput="onSystolicInput" />
    </view>

    <view class="form-item">
      <view class="label">舒张压（低压）<text class="unit">mmHg</text></view>
      <input class="input" type="digit" placeholder="请输入舒张压（40-150）" value="{{diastolic}}" bindinput="onDiastolicInput" />
    </view>

    <view class="form-item">
      <view class="label">心率<text class="unit">次/分</text></view>
      <input class="input" type="digit" placeholder="请输入心率（30-200）" value="{{heartRate}}" bindinput="onHeartRateInput" />
    </view>

    <view class="form-item">
      <view class="label">测量时间</view>
      <picker mode="date" value="{{measuredAt}}" bindchange="onTimeChange">
        <view class="picker">{{measuredAt || '请选择时间'}}</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="section-title">标签（可多选）</view>
    <view class="tags">
      <view 
        wx:for="{{tags}}" 
        wx:key="*this" 
        class="tag {{selectedTags.indexOf(item) > -1 ? 'tag-active' : ''}}"
        data-tag="{{item}}"
        bindtap="toggleTag"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">备注（可选）</view>
    <textarea 
      class="textarea" 
      placeholder="最多50字" 
      maxlength="50" 
      value="{{note}}"
      bindinput="onNoteInput"
    />
  </view>

  <view class="card">
    <button class="btn btn-primary" bindtap="handleSave">保存记录</button>
  </view>

  <view class="card tips">
    <view class="section-title">拍照识别（规划中）</view>
    <view class="tip-text">未来版本将支持拍照自动识别血压计读数</view>
  </view>
</view>
