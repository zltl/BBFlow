<view class="container">
  <view class="ocr-section">
    <view class="ocr-card" bindtap="onOCRScan">
      <view class="ocr-icon">📷</view>
      <view class="ocr-text">拍照智能识别</view>
      <view class="ocr-subtext">自动识别屏幕读数</view>
    </view>
  </view>

  <form bindsubmit="saveRecord">
    <view class="form-group">
      <view class="form-item">
        <text class="label">收缩压 (高压)</text>
        <input class="input" type="number" name="systolic" value="{{systolic}}" placeholder="70-260 mmHg" bindinput="onSystolicInput" />
      </view>
      <view class="form-item">
        <text class="label">舒张压 (低压)</text>
        <input class="input" type="number" name="diastolic" value="{{diastolic}}" placeholder="40-150 mmHg" bindinput="onDiastolicInput" />
      </view>
      <view class="form-item">
        <text class="label">心率</text>
        <input class="input" type="number" name="heartRate" value="{{heartRate}}" placeholder="30-200 次/分" bindinput="onHeartRateInput" />
      </view>
    </view>

    <view class="form-group">
      <view class="form-item">
        <text class="label">测量时间</text>
        <picker mode="date" value="{{date}}" bindchange="bindDateChange">
          <view class="picker">
            {{date}}
          </view>
        </picker>
        <picker mode="time" value="{{time}}" bindchange="bindTimeChange">
          <view class="picker" style="margin-left: 20rpx;">
            {{time}}
          </view>
        </picker>
      </view>
    </view>

    <view class="form-group">
      <view class="section-title">标签</view>
      <view class="tags-container">
        <block wx:for="{{tags}}" wx:key="*this">
          <view class="tag {{selectedTags[item] ? 'selected' : ''}}" bindtap="toggleTag" data-tag="{{item}}">
            {{item}}
          </view>
        </block>
      </view>
    </view>

    <view class="form-group">
      <view class="section-title">备注</view>
      <textarea class="textarea" name="note" placeholder="如有不适请备注（最多50字）" maxlength="50" bindinput="onNoteInput"></textarea>
    </view>

    <view class="btn-area">
      <button type="primary" formType="submit">保存记录</button>
    </view>
  </form>
</view>
