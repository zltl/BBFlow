.page {
  padding: 32rpx;
  padding-bottom: 64rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.unit {
  color: #999;
  font-size: 24rpx;
  margin-left: 8rpx;
  font-weight: 400;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.picker {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  line-height: 88rpx;
  color: #333;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: 2rpx solid #f5f5f5;
}

.tag-active {
  background-color: #fff5f5;
  color: #ff6b6b;
  border-color: #ff6b6b;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.tips {
  background-color: #fffbf0;
  border: 2rpx solid #ffe6b3;
}

.tip-text {
  color: #999;
  font-size: 26rpx;
  line-height: 1.6;
}
