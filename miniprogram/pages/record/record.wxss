/* Global Page Settings */
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

.container {
  padding: 30rpx;
  padding-bottom: 120rpx; /* Space for bottom button */
}

/* OCR Section */
.ocr-section {
  margin-bottom: 30rpx;
}

.ocr-card {
  background: linear-gradient(135deg, #e8f5e9 0%, #ffffff 100%);
  border: 2rpx dashed #07c160;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.1);
  transition: all 0.3s ease;
}

.ocr-card:active {
  transform: scale(0.98);
  background: #e0f2f1;
}

.ocr-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.ocr-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #07c160;
  margin-bottom: 8rpx;
}

.ocr-subtext {
  font-size: 24rpx;
  color: #888;
}

/* Form Groups */
.form-group {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.input-placeholder {
  color: #ccc;
  font-weight: 400;
}

/* Picker */
.picker-group {
  display: flex;
  align-items: center;
}

.picker {
  font-size: 30rpx;
  color: #333;
  background-color: #f5f5f5;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  margin-left: 20rpx;
}

/* Tags */
.section-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
  padding-top: 30rpx;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 30rpx;
}

.tag {
  padding: 12rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s;
  border: 1rpx solid transparent;
}

.tag.selected {
  background-color: #e8f5e9;
  color: #07c160;
  border-color: #07c160;
  font-weight: 500;
}

/* Textarea */
.textarea-wrapper {
  padding-bottom: 30rpx;
}

.textarea {
  width: 100%;
  height: 180rpx;
  font-size: 30rpx;
  color: #333;
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* Button */
.btn-area {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

button[type='primary'] {
  background-color: #07c160 !important;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

button[type='primary']:active {
  background-color: #06ad56 !important;
}
