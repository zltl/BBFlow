/* Global Page Settings */
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

.container {
  padding: 30rpx;
  padding-bottom: 160rpx; /* Space for bottom button */
}

/* OCR Section */
.ocr-section {
  margin-bottom: 20rpx; /* Reduced from 30rpx to fit the link closer */
}

.ocr-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}

.ocr-card:active {
  transform: scale(0.99);
  background-color: #fafafa;
}

/* Decorative background circle */
.ocr-card::after {
  content: '';
  position: absolute;
  right: -20rpx;
  top: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(7, 193, 96, 0.05);
  border-radius: 50%;
}

.ocr-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.ocr-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ocr-icon {
  font-size: 44rpx;
}

.ocr-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ocr-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.ocr-desc {
  font-size: 24rpx;
  color: #999;
}

.ocr-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

/* Form Groups */
.form-group {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 0 32rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.label-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 200rpx;
}

.label-main {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.label-sub {
  font-size: 24rpx;
  color: #999;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  min-width: 200rpx;
}

/* Picker Styles */
.picker-full {
  flex: 1;
  text-align: right;
}

.picker-display {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  font-family: 'DIN Alternate', -apple-system-font, sans-serif;
}

.picker-display.placeholder {
  color: #ccc;
  font-weight: 400;
}

.time-picker-group {
  display: flex;
  gap: 16rpx;
}

.picker-tag {
  background-color: #f5f5f5;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* Tags */
.section-header {
  padding-top: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-bottom: 32rpx;
}

.tag {
  padding: 14rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.tag.selected {
  background-color: #e8f5e9;
  color: #07c160;
  border-color: #07c160;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}

.add-tag {
  background-color: #fff;
  border: 2rpx dashed #ccc;
  color: #999;
}

.add-tag:active {
  background-color: #f5f5f5;
}

/* Textarea */
.textarea {
  width: 100%;
  height: 240rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  padding-bottom: 32rpx;
}

/* Button */
.btn-area {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.save-btn {
  background-color: #07c160 !important;
  color: #fff !important;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.2s;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

/* Guide Link */
.guide-link-container {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 30rpx;
  padding-right: 10rpx;
}

.guide-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #1890ff;
  padding: 10rpx 20rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 30rpx;
}

.guide-icon {
  font-size: 28rpx;
}
