page {
  background: #f6f8fb;
}

.page {
  padding: 24rpx;
}

.hero-card,
.action-card,
.stat-card,
.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
}

.hero-card,
.card {
  padding: 32rpx;
}

.hero-title,
.section-title,
.action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.hero-subtitle,
.section-desc,
.action-desc,
.link-meta,
.stat-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.action-grid,
.stats-grid {
  margin-top: 24rpx;
  display: grid;
  gap: 16rpx;
}

.action-grid {
  grid-template-columns: repeat(2, 1fr);
}

.stats-grid {
  grid-template-columns: repeat(2, 1fr);
}

.action-card,
.stat-card {
  padding: 28rpx;
}

.action-icon {
  font-size: 40rpx;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.card {
  margin-top: 24rpx;
}

.link-item + .link-item {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f7;
}

.link-token {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  word-break: break-all;
}

.primary-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #fff;
}
