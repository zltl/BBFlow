.container {
  padding: 30rpx;
  background-color: #f4f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  width: 100%;
  margin-bottom: 40rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
}

.range-selector {
  display: flex;
  background-color: #e0e0e0;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}

.range-item {
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.range-item.active {
  background-color: #1890ff;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.3);
}

.preview-area {
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border-radius: 16rpx;
  overflow: hidden;
}

.share-canvas {
  background-color: #fff;
}

.action-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.share-btn {
  background-color: #52c41a;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(82, 196, 26, 0.3);
  min-width: 240rpx;
}

.save-btn {
  background-color: #1890ff;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  margin-bottom: 0;
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.3);
  min-width: 240rpx;
}

.link-share-entry {
  margin-top: 30rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #1890ff;
  text-decoration: underline;
}

.tips {
  font-size: 22rpx;
  color: #999;
  margin-top: 20rpx;
}
