<view class="container">
  <view class="header">
    <text class="title">生成分享报告</text>
    <text class="subtitle">选择时间范围，生成您的健康概览</text>
  </view>

  <view class="range-selector">
    <view class="range-item {{timeRange === '7' ? 'active' : ''}}" bindtap="onRangeChange" data-range="7">
      最近7天
    </view>
    <view class="range-item {{timeRange === '30' ? 'active' : ''}}" bindtap="onRangeChange" data-range="30">
      最近30天
    </view>
  </view>

  <view class="preview-area">
    <view class="table-view-container">
      <scroll-view scroll-x="true" class="table-scroll" enhanced="true" show-scrollbar="true">
        <view class="bp-table-daily">
          <!-- Header Row 1: Group titles -->
          <view class="table-header-top">
            <view class="header-cell cell-date">日期</view>
            <view class="header-cell cell-item"></view>
            <view class="header-cell cell-item">早上</view>
            <view class="header-cell cell-item"></view>
            <view class="header-cell cell-item"></view>
            <view class="header-cell cell-item">中午</view>
            <view class="header-cell cell-item"></view>
            <view class="header-cell cell-item"></view>
            <view class="header-cell cell-item">晚上</view>
            <view class="header-cell cell-item"></view>
          </view>
          <!-- Header Row 2: Sub titles -->
          <view class="table-header-sub">
            <view class="header-cell cell-date"></view>
            <view class="header-cell cell-item">收缩</view>
            <view class="header-cell cell-item">舒张</view>
            <view class="header-cell cell-item">心率</view>
            <view class="header-cell cell-item">收缩</view>
            <view class="header-cell cell-item">舒张</view>
            <view class="header-cell cell-item">心率</view>
            <view class="header-cell cell-item">收缩</view>
            <view class="header-cell cell-item">舒张</view>
            <view class="header-cell cell-item">心率</view>
          </view>
          <!-- Data Rows -->
          <view class="table-data-row" wx:for="{{tableData}}" wx:key="date">
            <view class="data-cell cell-date">{{item.dateLabel}}</view>
            <!-- Morning -->
            <view class="data-cell cell-item {{item.morning.sys >= 140 ? 'abnormal' : ''}}">{{item.morning.sys || '-'}}</view>
            <view class="data-cell cell-item {{item.morning.dia >= 90 ? 'abnormal' : ''}}">{{item.morning.dia || '-'}}</view>
            <view class="data-cell cell-item">{{item.morning.hr || '-'}}</view>
            <!-- Noon -->
            <view class="data-cell cell-item {{item.noon.sys >= 140 ? 'abnormal' : ''}}">{{item.noon.sys || '-'}}</view>
            <view class="data-cell cell-item {{item.noon.dia >= 90 ? 'abnormal' : ''}}">{{item.noon.dia || '-'}}</view>
            <view class="data-cell cell-item">{{item.noon.hr || '-'}}</view>
            <!-- Evening -->
            <view class="data-cell cell-item {{item.evening.sys >= 140 ? 'abnormal' : ''}}">{{item.evening.sys || '-'}}</view>
            <view class="data-cell cell-item {{item.evening.dia >= 90 ? 'abnormal' : ''}}">{{item.evening.dia || '-'}}</view>
            <view class="data-cell cell-item">{{item.evening.hr || '-'}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- Hidden Canvas for Image Generation -->
  <canvas type="2d" id="shareCanvas" style="position: fixed; left: -9999px; top: 0; width: {{canvasWidth}}px; height: {{canvasHeight}}px;"></canvas>

  <view class="action-area">
    <view class="btn-group">
      <button class="share-btn" bindtap="onShareImage">微信好友分享</button>
    </view>
    <view class="tips">将以图片形式直接发送给好友</view>
  </view>
</view>
