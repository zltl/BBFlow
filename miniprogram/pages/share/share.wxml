<view class="page">
  <view class="hero-card">
    <view class="hero-title">数据中心</view>
    <view class="hero-subtitle">集中处理分享、导出和会员相关操作，不再分散在多个入口里。</view>
  </view>

  <view class="action-grid">
    <view class="action-card" bindtap="goToShareReport">
      <text class="action-icon">🖼️</text>
      <text class="action-title">生成分享图片</text>
      <text class="action-desc">适合发给家人或医生</text>
    </view>
    <view class="action-card" bindtap="goToCreateLink">
      <text class="action-icon">🔗</text>
      <text class="action-title">新建分享链接</text>
      <text class="action-desc">生成可查看数据的链接</text>
    </view>
    <view class="action-card" bindtap="goToManageLinks">
      <text class="action-icon">🛡️</text>
      <text class="action-title">管理分享链接</text>
      <text class="action-desc">查看访问次数并撤销</text>
    </view>
    <view class="action-card" bindtap="goToExportCenter">
      <text class="action-icon">📦</text>
      <text class="action-title">导出数据</text>
      <text class="action-desc">下载 JSON / CSV 备份</text>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-value">{{summary.total}}</text>
      <text class="stat-label">全部链接</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{summary.active}}</text>
      <text class="stat-label">生效中</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{summary.revoked}}</text>
      <text class="stat-label">已撤销</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{summary.access}}</text>
      <text class="stat-label">累计访问</text>
    </view>
  </view>

  <view class="card" wx:if="{{recentLinks.length > 0}}">
    <view class="section-title">最近创建的分享链接</view>
    <view class="link-item" wx:for="{{recentLinks}}" wx:key="token">
      <view class="link-token">{{item.token}}</view>
      <view class="link-meta">状态：{{item.statusLabel}} · 过期：{{item.expiresAtText}} · 访问 {{item.access_count}} 次</view>
    </view>
  </view>

  <view class="card membership-card">
    <view class="section-title">会员与权益</view>
    <view class="section-desc">查看套餐、订阅状态和订单历史；支付签名参数准备好后，这里会继续承接微信支付。</view>
    <button class="primary-btn" bindtap="goToSubscription">打开会员中心</button>
  </view>
</view>
