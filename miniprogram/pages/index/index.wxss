.page {
  padding: 32rpx;
  padding-bottom: 64rpx;
}

.welcome-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 64rpx;
}

.welcome-content {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  width: 100%;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}

.welcome-desc {
  margin-bottom: 32rpx;
}

.welcome-item {
  font-size: 28rpx;
  line-height: 2;
  color: #666;
}

.disclaimer {
  background-color: #fffbf0;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.disclaimer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff8800;
  margin-bottom: 12rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #999;
}

.hero {
  background: linear-gradient(135deg, #ff9aa2, #ff6b6b);
  color: #fff;
}

.hero .title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero .subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.login-card {
  text-align: center;
}

.login-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.user-card {
  padding: 24rpx 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 24rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.feature {
  color: #666;
  font-size: 28rpx;
  line-height: 1.8;
}
