<view class="container">
  <view class="header">
    <picker mode="date" fields="month" value="{{filterDate}}" bindchange="onDateFilterChange">
      <view class="filter-btn">
        {{filterDate || '全部日期'}} <text class="arrow">▼</text>
      </view>
    </picker>
    <view class="stats" wx:if="{{records.length > 0}}">
      <!-- 共 {{records.length}} 条记录 -->
    </view>
  </view>

  <scroll-view scroll-y class="records-container" bindscrolltolower="onReachBottom">
    <block wx:if="{{records.length === 0 && !isLoading}}">
      <view class="empty-state">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无记录</text>
        <button class="add-btn" bindtap="goToRecord">开始记录</button>
      </view>
    </block>
    <block wx:else>
      <view class="date-group" wx:for="{{records}}" wx:key="date">
        <view class="date-header">{{item.date}}</view>
        <view class="record-list">
          <view class="record-card" wx:for="{{item.records}}" wx:key="id" wx:for-item="record" bindtap="showDetail" data-item="{{record}}">
            <view class="card-main">
              <!-- Top Row: Time & Tags -->
              <view class="card-top">
                <view class="time-tag-group">
                  <text class="time">{{record.timeStr}}</text>
                  <text class="period-tag" wx:if="{{record.tags && record.tags.length > 0}}">{{record.tags[0]}}</text>
                </view>
                <view class="warning-group" wx:if="{{record.hypertensionLevel.level >= 2}}">
                    <text class="warning-text" wx:if="{{record.hypertensionLevel.detail}}">{{record.hypertensionLevel.detail}}</text>
                    <view class="warning-icon">⚠️</view>
                </view>
              </view>

              <!-- Middle Row: BP & Status -->
              <view class="card-middle">
                <view class="bp-section">
                  <text class="bp-value">{{record.systolic}}/{{record.diastolic}}</text>
                  <!-- Unit removed as requested -->
                </view>
                <view class="status-section">
                  <view class="status-badge" style="background-color: {{record.hypertensionLevel.color}}20; color: {{record.hypertensionLevel.color}}">
                    {{record.hypertensionLevel.text}}
                  </view>
                  <view class="hr-item">
                    <text class="hr-value">{{record.heartRate}}</text>
                    <text class="hr-icon">❤️</text>
                  </view>
                </view>
              </view>

              <!-- Bottom Row: Notes (if any) -->
              <view class="card-bottom" wx:if="{{record.note}}">
                <text class="note-icon">📝</text>
                <text class="note-text">{{record.note}}</text>
              </view>
            </view>

            <!-- Right Arrow -->
            <view class="card-arrow">
              <text class="arrow-icon">›</text>
            </view>
          </view>
        </view>
      </view>
      
      <view class="loading-footer" wx:if="{{isLoading}}">
        <text>加载中...</text>
      </view>
      <view class="loading-footer" wx:if="{{!hasMore && records.length > 0}}">
        <text>没有更多记录了</text>
      </view>
    </block>
  </scroll-view>
</view>
