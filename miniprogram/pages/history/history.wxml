<view class="container">
  <view class="header">
    <picker mode="date" fields="month" value="{{filterDate}}" bindchange="onDateFilterChange">
      <view class="filter-btn">
        {{filterDate || '全部日期'}} <text class="arrow">▼</text>
      </view>
    </picker>
    <view class="stats" wx:if="{{records.length > 0}}">
      共 {{records.length}} 条记录
    </view>
  </view>

  <scroll-view scroll-y class="list-container">
    <block wx:if="{{records.length === 0}}">
      <view class="empty-state">
        <text>暂无记录</text>
        <button class="add-btn" bindtap="goToRecord">去记录</button>
      </view>
    </block>
    <block wx:else>
      <view class="record-item" wx:for="{{records}}" wx:key="id" bindtap="showDetail" data-item="{{item}}">
        <view class="record-main">
          <view class="record-time">{{item.measuredAt}}</view>
          <view class="record-values">
            <view class="value-group">
              <text class="label">高压</text>
              <text class="value {{item.systolic > 140 || item.systolic < 90 ? 'warning' : ''}}">{{item.systolic}}</text>
            </view>
            <view class="divider">/</view>
            <view class="value-group">
              <text class="label">低压</text>
              <text class="value {{item.diastolic > 90 || item.diastolic < 60 ? 'warning' : ''}}">{{item.diastolic}}</text>
            </view>
            <view class="value-group hr">
              <text class="label">心率</text>
              <text class="value">{{item.heartRate}}</text>
            </view>
          </view>
        </view>
        <view class="record-tags" wx:if="{{item.tags && item.tags.length > 0}}">
          <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
