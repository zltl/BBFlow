<view class="container">
  <view class="header">
    <picker mode="date" fields="month" value="{{filterDate}}" bindchange="onDateFilterChange">
      <view class="filter-btn">
        {{filterDate || '全部日期'}} <text class="arrow">▼</text>
      </view>
    </picker>
    <view class="stats" wx:if="{{records.length > 0}}">
      共 {{records.length}} 条记录
    </view>
  </view>

  <scroll-view scroll-y class="records-container">
    <block wx:if="{{records.length === 0}}">
      <view class="empty-state">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无记录</text>
        <button class="add-btn" bindtap="goToRecord">开始记录</button>
      </view>
    </block>
    <block wx:else>
      <view class="date-group" wx:for="{{records}}" wx:key="date">
        <view class="date-header">{{item.date}}</view>
        <view class="record-list">
          <view class="record-card" wx:for="{{item.records}}" wx:key="id" wx:for-item="record" bindtap="showDetail" data-item="{{record}}">
            <view class="level-indicator" style="background-color: {{record.hypertensionLevel.color}}"></view>
            <view class="card-content">
              <view class="card-header">
                <text class="time">{{record.timeStr}}</text>
                <view class="status-badge" wx:if="{{record.hypertensionLevel.level >= 0}}" style="background-color: {{record.hypertensionLevel.color}}20; color: {{record.hypertensionLevel.color}}">
                  {{record.hypertensionLevel.text}}
                </view>
              </view>
              <view class="card-body">
                <view class="bp-group">
                  <text class="bp-value">{{record.systolic}}/{{record.diastolic}}</text>
                  <text class="bp-unit">mmHg</text>
                </view>
                <view class="hr-group">
                  <text class="hr-value">{{record.heartRate}}</text>
                  <text class="hr-label">心率</text>
                </view>
              </view>
              <view class="card-footer" wx:if="{{(record.tags && record.tags.length > 0) || record.note}}">
                <view class="tags" wx:if="{{record.tags && record.tags.length > 0}}">
                  <text class="tag" wx:for="{{record.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
                </view>
                <text class="note" wx:if="{{record.note}}">{{record.note}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
