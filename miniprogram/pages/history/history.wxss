.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  padding: 20rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.filter-btn {
  font-size: 30rpx;
  color: #333;
  padding: 10rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 30rpx;
}

.stats {
  font-size: 28rpx;
  color: #999;
}

.list-container {
  flex: 1;
  padding: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999;
}

.add-btn {
  margin-top: 40rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 30rpx;
}

.record-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.record-time {
  font-size: 28rpx;
  color: #999;
}

.record-values {
  display: flex;
  align-items: center;
}

.value-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 10rpx;
}

.divider {
  color: #ccc;
  font-size: 40rpx;
  margin-top: 10rpx;
}

.label {
  font-size: 20rpx;
  color: #999;
}

.value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.value.warning {
  color: #ff4d4f;
}

.hr .value {
  font-size: 32rpx;
  color: #666;
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 15rpx;
}

.tag {
  font-size: 22rpx;
  color: #1890ff;
  background-color: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}
