.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  padding: 10rpx 20rpx;
  background-color: #fff;
  display: flex;
  justify-content: flex-start; /* Align to left */
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.filter-btn {
  font-size: 28rpx; /* Slightly smaller font for compactness */
  color: #333;
  padding: 8rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stats {
  font-size: 28rpx;
  color: #999;
}

.records-container {
  flex: 1;
  padding: 0 20rpx 20rpx;
}

/* Date Group */
.date-group {
  margin-bottom: 40rpx;
}

.date-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 10rpx 16rpx;
  position: sticky;
  top: 0;
  background-color: #f8f8f8;
  z-index: 10;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* Record Card */
.record-card {
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
  position: relative;
}

.record-card:active {
  transform: scale(0.99);
  background-color: #fafafa;
}

.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* Top Row: Time & Tags */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-tag-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time {
  font-size: 40rpx; /* Increased from 32rpx */
  font-weight: 600;
  color: #333;
  font-family: 'DIN Alternate', sans-serif;
  margin-right: 8rpx;
}

.period-tag {
  font-size: 22rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  vertical-align: middle;
}

.warning-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.warning-text {
  font-size: 22rpx;
  color: #ff4d4f;
}

.warning-icon {
  font-size: 28rpx;
}

/* Middle Row: BP & Status */
.card-middle {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.bp-section {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bp-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #333;
  font-family: 'DIN Alternate', sans-serif;
  line-height: 1;
}

.bp-unit {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.status-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

.hr-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hr-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  font-family: 'DIN Alternate', sans-serif;
}

.hr-icon {
  font-size: 24rpx;
}

/* Bottom Row: Notes */
.card-bottom {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.note-icon {
  font-size: 24rpx;
  margin-top: 2rpx;
}

.note-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  flex: 1;
}

/* Right Arrow */
.card-arrow {
  padding-left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

/* Empty State & Footer */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.add-btn {
  background-color: #1890ff;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.loading-footer {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
