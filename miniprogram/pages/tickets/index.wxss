page {
  background: #f6f8fb;
}

.page {
  padding: 24rpx;
}

.hero-card,
.composer-card,
.empty-card,
.ticket-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
}

.hero-card,
.composer-card,
.empty-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero-title,
.section-title,
.ticket-subject,
.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.hero-subtitle,
.ticket-meta,
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.input,
.textarea {
  margin-top: 20rpx;
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.textarea {
  min-height: 220rpx;
}

.primary-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #fff;
}

.ticket-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ticket-card {
  padding: 28rpx;
}

.ticket-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.status {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status.active {
  background: rgba(22, 119, 255, 0.12);
  color: #1668dc;
}

.status.muted {
  background: rgba(148, 163, 184, 0.14);
  color: #64748b;
}

.ticket-link {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #1668dc;
  font-weight: 600;
}
