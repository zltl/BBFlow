page {
  background: #f6f8fb;
}

.page {
  padding: 24rpx;
}

.header-card,
.message,
.reply-card,
.empty-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
}

.header-card,
.reply-card,
.empty-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.subject {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.meta,
.message-time,
.message-sender {
  font-size: 24rpx;
  color: #64748b;
}

.meta {
  margin-top: 12rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.message {
  padding: 28rpx;
}

.message.user {
  border: 2rpx solid rgba(22, 119, 255, 0.08);
}

.message.admin {
  border: 2rpx solid rgba(82, 196, 26, 0.1);
}

.message-content {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #111827;
}

.message-time {
  margin-top: 16rpx;
}

.textarea {
  min-height: 220rpx;
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.primary-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #fff;
}
