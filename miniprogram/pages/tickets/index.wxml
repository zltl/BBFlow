<view class="page">
  <view class="hero-card">
    <view class="hero-title">工单中心</view>
    <view class="hero-subtitle">提交功能问题、导出需求或支付相关问题，后续可在这里继续追踪和回复。</view>
  </view>

  <view class="composer-card">
    <view class="section-title">新建工单</view>
    <input class="input" placeholder="问题主题，例如：OCR 识别结果有误" value="{{subject}}" bindinput="onSubjectInput" />
    <textarea class="textarea" placeholder="请尽量描述问题场景、时间和希望得到的帮助" value="{{content}}" bindinput="onContentInput"></textarea>
    <button class="primary-btn" bindtap="createTicket">提交工单</button>
  </view>

  <view class="empty-card" wx:if="{{!isLoading && tickets.length === 0}}">
    <text class="empty-title">暂无工单记录</text>
    <text class="empty-desc">提交后可在这里查看处理状态和对话记录。</text>
  </view>

  <view class="ticket-list" wx:if="{{tickets.length > 0}}">
    <view class="ticket-card" wx:for="{{tickets}}" wx:key="id" bindtap="openTicket" data-item="{{item}}">
      <view class="ticket-head">
        <view class="ticket-subject">{{item.subject}}</view>
        <view class="status {{item.status === 'closed' ? 'muted' : 'active'}}">{{item.statusLabel}}</view>
      </view>
      <view class="ticket-meta">优先级：{{item.priority || 'normal'}} · 最近更新：{{item.updatedAtText}}</view>
      <view class="ticket-link">查看详情 ›</view>
    </view>
  </view>
</view>
